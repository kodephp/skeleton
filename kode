#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * 骨架入口薄壳：转发至 vendor/kode/framework 的 CLI 唯一实现。
 *
 * 本文件只做定位 + 转发，不含业务逻辑——框架 `composer update` 后新命令
 * （start/status/…）自动生效，无需重建项目；切勿在此复制第二份实现。
 */
$root = __DIR__;
$candidates = [
    $root . '/vendor/kode/framework/kode',
    $root . '/vendor/kode/framework/bin/kode',
];
foreach ($candidates as $fwBin) {
    if (is_file($fwBin) && realpath($fwBin) !== realpath(__FILE__)) {
        require $fwBin;
        exit(0);
    }
}

fwrite(STDERR, "无法定位框架 CLI（vendor/kode/framework 未安装），请先执行 composer install。\n");
exit(1);
