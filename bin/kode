#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Kode 骨架项目命令行入口（薄壳转发）。
 *
 * 为什么这里不自带一份实现：
 *   历史上骨架与框架各存一份 bin/kode，两份独立演进。结果 `status` 在骨架里长期
 *   停留在「打一次 /health 接口」的老实现，而框架侧的 workerman 风格进程表、
 *   守护模式、Ctrl+C 快速排空等能力一律缺席——`composer update` 也拉不到，
 *   因为骨架的 bin/kode 挡在前面。此处收敛为薄壳：CLI 的唯一实现在
 *   `vendor/kode/framework/bin/kode`，骨架只负责定位并转发，从此不可能再漂移。
 *
 * 用法与框架完全一致：
 *   php bin/kode serve [--host H] [--port P] [--workers N] [--watch] [--daemon|-d] [--graceful N]
 *   php bin/kode status [--pid=N]     workerman 风格 GLOBAL/PROCESS STATUS 进程表
 *   php bin/kode stop [-g]            停止服务（默认优雅停机，-g 强制 SIGKILL）
 *   php bin/kode reload               平滑重启 worker
 *   php bin/kode restart              停止并以守护模式重新拉起
 *   php bin/kode cron                 常驻运行 #[Cron] 定时任务
 *   php bin/kode help                 全部命令
 */

$root = dirname(__DIR__);

// 覆盖点：本地开发可用 KODE_FRAMEWORK_BIN 指向框架仓库里的 bin/kode，
// 便于在正式发版前直接验证未发布的内核改动。
$candidates = array_filter([
    getenv('KODE_FRAMEWORK_BIN') ?: '',
    $root . '/vendor/kode/framework/bin/kode',
    $root . '/vendor/bin/kode',
]);

$bin = null;
foreach ($candidates as $candidate) {
    if (is_file($candidate)) {
        $bin = $candidate;
        break;
    }
}

if ($bin === null) {
    fwrite(STDERR, "未找到 kode/framework 的命令行入口。请先安装依赖：\n");
    fwrite(STDERR, "    composer install\n");
    fwrite(STDERR, "（已安装但仍报此错时，检查 vendor/kode/framework/bin/kode 是否存在）\n");
    exit(1);
}

$args = array_slice($argv, 1);

if (function_exists('pcntl_exec')) {
    // 用 pcntl_exec（进程替换）而不是 require / passthru：
    //  - require 会把被包含文件的 shebang 行当普通文本输出——PHP 只对**主脚本**剥离 `#!`；
    //  - 进程替换而非父子进程：PID 不变、信号直达、退出码原样返回，
    //    于是 Ctrl+C 的优雅停机链路与直接执行框架入口逐字一致，多一层壳不改变任何行为。
    // 成功时不返回；返回 false 才是失败，落到下面的子进程兜底。
    $ok = @pcntl_exec(PHP_BINARY, array_merge([$bin], $args));
    if ($ok === false && function_exists('pcntl_get_last_error')) {
        fwrite(STDERR, "[kode] pcntl_exec 失败（" . pcntl_strerror(pcntl_get_last_error()) . "），改用子进程方式执行。\n");
    }
}

// 兜底路径（pcntl 不可用或 exec 失败）：起子进程转发。
// 此时 Ctrl+C 会打到整个进程组，父进程必须先忽略停机信号，
// 否则父进程先死、终端提前返回，而子进程还在后台排空在途请求。
if (function_exists('pcntl_signal')) {
    @pcntl_signal(SIGINT, SIG_IGN);
    @pcntl_signal(SIGTERM, SIG_IGN);
}

$cmd = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($bin);
foreach ($args as $arg) {
    $cmd .= ' ' . escapeshellarg((string) $arg);
}

passthru($cmd, $code);

exit($code);
