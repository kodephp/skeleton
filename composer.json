{
    "name": "kode/skeleton",
    "description": "Kode Framework Skeleton —— composer create-project 后自动生成 app/config 等骨架",
    "type": "project",
    "keywords": ["kode", "skeleton", "hyperf", "webman"],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {"symlink": true}
        }
    ],
    "require": {
        "php": ">=8.3",
        "kode/framework": "*",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "symfony/translation": "^7.0",
        "symfony/validator": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "app\\tests\\": "tests/"
        }
    },
    "bin": ["bin/kode"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {"*": true}
    },
    "scripts": {
        "post-create-project-cmd": "php bin/kode init",
        "serve": "php bin/kode serve",
        "test": "php vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
